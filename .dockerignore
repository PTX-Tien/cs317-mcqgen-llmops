# ── HỆ THỐNG VÀ PHIÊN BẢN (Git / DVC) ─────────────────────────────────────────
.git
.gitignore
.dvc
.dvcignore
.dvc-site-cache
.dvc-tmp

# ── THƯ MỤC CONFIG VÀ BẢO MẬT (Không mang vào image) ──────────────────────────
.env
.env.local
**/.env.local
.env.*
monitoring/langfuse/.env

# ── CACHE VÀ PYTHON RUNTIME (Giảm dung lượng build backend) ────────────────────
.cache
.pytest_cache
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv
env

# ── LOGS VÀ THƯ MỤC TẠM (Runtime Outputs) ────────────────────────────────────
logs
redis_data
tmp
results
*.log
*.tmp
.nfs*

# ── THƯ MỤC FRONTEND BUILD CACHE (Giảm dung lượng build Next.js) ───────────────
webapp/node_modules
webapp/.next
webapp/out
webapp/tsconfig.tsbuildinfo
webapp/.docusaurus

# ── DATA ARTIFACTS (Chỉ mang file mẫu, không mang dữ liệu nặng) ──────────────
# Giữ cấu trúc thư mục rỗng để container mount volume thành công, bỏ qua ruột
data/indexes/*
data/processed/*
data/*.db
data/*.db-shm
data/*.db-wal
input/slide/*
input/transcribe_data/*
output/*
models/*
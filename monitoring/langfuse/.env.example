# LangFuse self-host settings. Keep the real .env file out of Git.
LANGFUSE_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-secret
SALT=replace-with-random-salt
ENCRYPTION_KEY=replace-with-64-hex-chars
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

POSTGRES_DB=langfuse
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=replace-with-postgres-password

CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=replace-with-clickhouse-password

MINIO_ROOT_USER=langfuse-minio
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_BUCKET=langfuse
MINIO_CONSOLE_PORT=9001


# ─────────────────────────────────────────────────────────────────────────────
# MCQGen - Docker Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────

# ── vLLM (Chạy trong Docker mạng nội bộ dùng tên service 'vllm') ──────────────
VLLM_URL=http://vllm:7681/v1
VLLM_MODEL=mcqgen
VLLM_TIMEOUT=180
VLLM_MAX_RETRIES=1
START_VLLM=1
VLLM_PORT=7681
VLLM_WAIT_SECONDS=0
VLLM_MAX_NUM_SEQS=4
VLLM_MAX_MODEL_LEN=5000

# ── Local service ports (Cổng map ra máy host) ─────────────────────────────────
API_PORT=8080
WEBAPP_PORT=8081
LANGFUSE_PORT=8083
START_LANGFUSE=1
LANGFUSE_WAIT_SECONDS=120
PUBLIC_HOST=localhost

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=mcqgen-cs116-secret-2026-change-in-production-abc123xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (Trỏ vào vùng volume /data được mount trong container) ───────────
DATABASE_URL=sqlite:////data/mcqgen.db

# ── Redis (Thay localhost thành tên service 'redis') ──────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
REDIS_SESSION_URL=redis://redis:6379/3
CELERY_QUEUE_ISOLATE_BY_USER=1
TASK_RESULT_TTL_SECONDS=86400

# ── Rate Limit ────────────────────────────────────────────────────────────────
RATE_LIMIT_TEACHER=10/hour
RATE_LIMIT_STUDENT=30/hour

# ── Monitoring (Thay localhost bằng tên service 'langfuse' của Docker) ────────
LOG_LEVEL=INFO
ENABLE_LANGFUSE=1
LANGFUSE_BASE_URL=http://langfuse:8083
LANGFUSE_PUBLIC_KEY=pk-lf-default-key-change-me
LANGFUSE_SECRET_KEY=sk-lf-default-key-change-me
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_MAX_IO_CHARS=12000

# ── Trace Tags ────────────────────────────────────────────────────────────────
APP_ENV=prod
TRACE_RUN_TYPE=docker-lab
LOAD_TEST_ID=
SERVER_INSTANCE=docker-node-1
REQUEST_SOURCE=web

# ── Pipeline ──────────────────────────────────────────────────────────────────
ENABLE_LLM_EVAL=0
DEFAULT_RETRIEVAL_MODE=auto
MCQGEN_RESOURCE_MAX_RUNNING_JOBS=4
MCQGEN_TARGET_CONCURRENT_USERS=4
CELERY_GENERATION_CONCURRENCY=4
CELERY_LOW_CONCURRENCY=1
MCQGEN_CONCURRENCY_AUTOTUNE=1
MCQGEN_DYNAMIC_CONCURRENCY=1
MCQGEN_GLOBAL_SLOT_GUARD=1
MCQGEN_GLOBAL_LLM_SLOTS=4
MCQGEN_LOAD_TRACKING_TTL_SECONDS=21600
MCQGEN_MAX_CONCURRENT_QUESTIONS=4
MCQGEN_LLM_MAX_CONCURRENCY=4
MCQGEN_LLM_STREAM_METRICS=1